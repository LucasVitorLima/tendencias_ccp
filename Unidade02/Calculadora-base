def calculadora():
a = float(input("Primeiro número: "))
op = input("Operação (+, -, *, /): ")
b = float(input("Segundo número: "))
if op == "+":
print(a + b)
if op == "-":
print(a - b)
if op == "*":
print(a * b)
if op == "/":
print(a / b)


if __name__ == "__main__":
calculadora()
