"""
Calculadora Simples - Atividade Prática
Programação Assistida por Inteligência Artificial

Ciclo aplicado:
1. Contextualizar & Sugerir (IA): estrutura em funções + dict dispatch
2. Avaliar Criticamente (Humano): checar divisão por zero e entrada inválida
3. Refatorar & Ajustar: tratamento de exceções, funções puras, loop de uso
4. Decidir & Integrar (Humano): versão final abaixo
"""


def somar(a: float, b: float) -> float:
return a + b


def subtrair(a: float, b: float) -> float:
return a - b


def multiplicar(a: float, b: float) -> float:
return a * b


def dividir(a: float, b: float) -> float:
if b == 0:
raise ZeroDivisionError("Não é possível dividir por zero.")
return a / b


OPERACOES = {
"+": somar,
"-": subtrair,
"*": multiplicar,
"/": dividir,
}


def ler_numero(mensagem: str) -> float:
"""Insiste até o usuário digitar um número válido."""
while True:
try:
return float(input(mensagem))
except ValueError:
print("Entrada inválida. Digite um número (ex: 3.5).")


def ler_operacao() -> str:
while True:
op = input(f"Operação {list(OPERACOES.keys())}: ").strip()
if op in OPERACOES:
return op
print("Operação inválida. Use +, -, * ou /.")


def calculadora():
print("=== Calculadora Simples ===")
while True:
a = ler_numero("Primeiro número: ")
op = ler_operacao()
b = ler_numero("Segundo número: ")

try:
resultado = OPERACOES[op](a, b)
print(f"Resultado: {a} {op} {b} = {resultado}\n")
except ZeroDivisionError as e:
print(f"Erro: {e}\n")

continuar = input("Fazer outro cálculo? (s/n): ").strip().lower()
if continuar != "s":
print("Encerrando calculadora.")
break


if __name__ == "__main__":
calculadora()
